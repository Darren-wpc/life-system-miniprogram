/* pages/profile/achievements/index.wxss - 成就徽章样式 */

/* ===== 进度概览头部 ===== */
.ach-header {
  padding: 32rpx;
}

.ach-header-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.ach-header-icon {
  font-size: 56rpx;
  line-height: 1;
  flex-shrink: 0;
}

.ach-header-info {
  flex: 1;
  min-width: 0;
}

.ach-header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}

.ach-header-sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.ach-header-percent {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
  flex-shrink: 0;
  line-height: 1;
}

.ach-progress-track {
  width: 100%;
  height: 16rpx;
  background: var(--bg);
  border-radius: 8rpx;
  overflow: hidden;
}

.ach-progress-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 8rpx;
  transition: width 0.4s ease;
}

/* ===== 分类汇总 ===== */
.ach-categories {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.ach-cat-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  background: var(--surface);
  border-radius: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.ach-cat-chip.cat-done {
  background: var(--success-light);
}

.ach-cat-name {
  font-size: 24rpx;
  color: var(--ink);
  font-weight: 500;
}

.ach-cat-count {
  font-size: 22rpx;
  color: var(--muted);
  font-weight: 600;
}

.cat-done .ach-cat-name {
  color: var(--success);
}

.cat-done .ach-cat-count {
  color: var(--success);
}

/* ===== 成就网格 ===== */
.ach-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.ach-card {
  width: calc(50% - 10rpx);
  background: var(--surface);
  border-radius: 24rpx;
  padding: 28rpx 24rpx 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  overflow: hidden;
}

/* 已解锁 - 全彩 */
.ach-card.is-unlocked {
  border-top: 6rpx solid var(--primary);
}

/* 未解锁 - 灰度 + 半透明 */
.ach-card.is-locked {
  opacity: 0.6;
  filter: grayscale(0.8);
  border-top: 6rpx solid var(--rule);
}

/* 图标区 */
.ach-icon-wrap {
  position: relative;
  margin-bottom: 16rpx;
}

.ach-icon {
  font-size: 64rpx;
  line-height: 1;
}

/* 锁定遮罩 */
.ach-lock {
  position: absolute;
  top: -4rpx;
  right: -16rpx;
  width: 40rpx;
  height: 40rpx;
  background: var(--surface);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.ach-lock-icon {
  font-size: 24rpx;
  line-height: 1;
}

/* 名称 */
.ach-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 8rpx;
  line-height: 1.3;
}

/* 描述 */
.ach-desc {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.5;
  margin-bottom: 16rpx;
  min-height: 66rpx;
}

/* 底部状态 */
.ach-foot {
  width: 100%;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--rule);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 44rpx;
}

.ach-foot-date {
  font-size: 22rpx;
  color: var(--muted);
}

.ach-foot-tag {
  font-size: 20rpx;
  color: var(--success);
  font-weight: 600;
  background: var(--success-light);
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.ach-foot-locked {
  font-size: 22rpx;
  color: var(--muted);
}
