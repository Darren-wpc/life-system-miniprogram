/* pages/toolkit/notodo-detail/index.wxss */

.notodo-list {
  margin-top: 8rpx;
}

.notodo-card {
  padding: 28rpx;
}

.notodo-body {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.notodo-icon {
  font-size: 28rpx;
  color: var(--danger);
  font-weight: 700;
  line-height: 1.5;
  flex-shrink: 0;
}

.notodo-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.notodo-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.5;
  word-break: break-all;
}

.notodo-reason {
  font-size: 24rpx;
  line-height: 1.5;
}

.notodo-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--rule);
}

.notodo-date {
  font-size: 22rpx;
}

.notodo-delete {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notodo-delete:active {
  opacity: 0.6;
}

.delete-icon {
  font-size: 36rpx;
  color: var(--danger);
  line-height: 1;
}

/* 添加触发器 */
.add-trigger {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx;
  margin-top: 16rpx;
  background: var(--surface);
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.add-trigger:active {
  opacity: 0.7;
}

.add-trigger-icon {
  font-size: 36rpx;
  color: var(--primary);
  font-weight: 700;
}

.add-trigger-text {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 500;
}

/* 添加表单 */
.add-form {
  margin-top: 16rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 24rpx;
}

.form-group {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.form-input {
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  background: var(--bg);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 100rpx;
  padding: 16rpx 20rpx;
  background: var(--bg);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.input-placeholder {
  color: var(--muted);
  font-size: 26rpx;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.cancel-btn,
.confirm-btn {
  flex: 1;
  padding: 20rpx 0;
  font-size: 28rpx;
  min-height: 0;
  line-height: 1.6;
}
