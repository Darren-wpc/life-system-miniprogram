/* pages/toolkit/restart/index.wxss */

/* 剧本列表 */
.script-list {
  margin-top: 8rpx;
}

.script-card {
  padding: 0;
  overflow: hidden;
}

.script-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}

.script-header:active {
  background: var(--bg);
}

.script-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  overflow: hidden;
}

.script-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.script-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  overflow: hidden;
}

.script-scenario {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.script-status {
  font-size: 22rpx;
}

.script-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.expand-arrow {
  font-size: 24rpx;
  color: var(--muted);
}

/* 展开内容 */
.script-body {
  padding: 0 28rpx 28rpx;
}

.body-divider {
  height: 1rpx;
  background: var(--rule);
  margin-bottom: 20rpx;
}

.body-label {
  display: block;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.plan-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: var(--bg);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.7;
  box-sizing: border-box;
}

.input-placeholder {
  color: var(--muted);
  font-size: 26rpx;
}

.textarea-footer {
  padding: 8rpx 0 0;
  text-align: right;
}

.script-delete-row {
  margin-top: 20rpx;
}

.delete-scenario-btn {
  width: 100%;
  padding: 16rpx 0;
  font-size: 26rpx;
  min-height: 0;
  line-height: 1.6;
}

/* 添加触发器 */
.add-trigger {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx;
  margin-top: 16rpx;
  background: var(--surface);
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.add-trigger:active {
  opacity: 0.7;
}

.add-trigger-icon {
  font-size: 36rpx;
  color: var(--primary);
  font-weight: 700;
}

.add-trigger-text {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 500;
}

/* 添加表单 */
.add-form {
  margin-top: 16rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 24rpx;
}

.form-group {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.form-input {
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  background: var(--bg);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.cancel-btn,
.confirm-btn {
  flex: 1;
  padding: 20rpx 0;
  font-size: 28rpx;
  min-height: 0;
  line-height: 1.6;
}
