<!--pages/toolkit/notodo/index.wxml - 工具箱枢纽页-->
<view class="page-container hub-page">

  <!-- 页面标题 -->
  <view class="hub-header">
    <view class="hub-header-left">
      <text class="hub-title">工具箱</text>
      <text class="hub-subtitle text-muted">六把人生防护武器</text>
    </view>
  </view>

  <!-- 工具卡片 2x3 网格 -->
  <view class="tool-grid">
    <view class="tool-card card {{filledTools[item.key] ? 'tool-card-filled' : ''}}"
          wx:for="{{tools}}" wx:key="key"
          data-key="{{item.key}}" bindtap="onToolTap">
      <view class="tool-card-icon" style="background: {{item.color}}20;">
        <text class="tool-emoji">{{item.icon}}</text>
      </view>
      <view class="tool-card-body">
        <view class="tool-card-name-row">
          <text class="tool-card-name">{{item.name}}</text>
          <view class="tool-filled-dot" wx:if="{{filledTools[item.key]}}"></view>
        </view>
        <text class="tool-card-desc text-muted">{{item.desc}}</text>
      </view>
      <view class="tool-card-arrow">
        <text class="arrow-icon">></text>
      </view>
    </view>
  </view>

  <!-- 每日精选提示卡 -->
  <view class="featured-card card">
    <view class="featured-header">
      <view class="featured-label">
        <text class="featured-icon">💡</text>
        <text class="featured-title">每日思考</text>
      </view>
      <view class="featured-refresh" bindtap="refreshTip">
        <text class="refresh-text text-primary">换一条</text>
      </view>
    </view>
    <view class="featured-body">
      <text class="featured-tip">{{dailyTip}}</text>
    </view>
    <view class="featured-footer">
      <text class="featured-hint text-muted">坚持使用工具箱，让边界越来越清晰</text>
    </view>
  </view>

  <!-- 使用统计 -->
  <view class="stats-row" wx:if="{{tools.length > 0}}">
    <view class="stat-item">
      <text class="stat-value">{{filledCount || 0}}/{{tools.length}}</text>
      <text class="stat-label text-muted">已启用工具</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{6 - (filledCount || 0)}}</text>
      <text class="stat-label text-muted">待探索</text>
    </view>
  </view>

</view>