/* pages/toolkit/notodo/index.wxss - 工具箱枢纽页样式 */

/* 页面头部 */
.hub-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.hub-header-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hub-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
}

.hub-subtitle {
  font-size: 24rpx;
  color: var(--muted);
}

/* 工具卡片网格 2x3 */
.tool-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.tool-card {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  position: relative;
  transition: all 0.2s ease;
}

.tool-card:active {
  transform: scale(0.97);
  opacity: 0.9;
}

/* 已填写的卡片 */
.tool-card-filled {
  border-left: 6rpx solid var(--primary);
}

/* 工具图标 */
.tool-card-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-emoji {
  font-size: 40rpx;
  line-height: 1;
}

/* 工具信息 */
.tool-card-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.tool-card-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tool-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.tool-filled-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--success);
  flex-shrink: 0;
}

.tool-card-desc {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.5;
}

/* 箭头 */
.tool-card-arrow {
  position: absolute;
  top: 28rpx;
  right: 24rpx;
}

.arrow-icon {
  font-size: 28rpx;
  color: var(--muted);
  font-weight: 300;
}

/* 每日精选卡片 */
.featured-card {
  background: linear-gradient(135deg, #f0fdfa 0%, #f8fafc 100%);
  border: 2rpx solid var(--primary-light);
  margin-bottom: 32rpx;
}

.featured-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.featured-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.featured-icon {
  font-size: 36rpx;
}

.featured-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.featured-refresh {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: var(--surface);
}

.refresh-text {
  font-size: 24rpx;
  font-weight: 500;
}

.featured-body {
  padding: 16rpx 0;
}

.featured-tip {
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.8;
}

.featured-footer {
  padding-top: 16rpx;
  border-top: 1rpx solid var(--rule);
}

.featured-hint {
  font-size: 22rpx;
}

/* 使用统计行 */
.stats-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  padding: 32rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}

.stat-label {
  font-size: 22rpx;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: var(--rule);
}