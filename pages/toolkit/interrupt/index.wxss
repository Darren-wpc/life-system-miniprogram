/* pages/toolkit/interrupt/index.wxss */

/* 进度条 */
.progress-bar {
  padding: 24rpx 32rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-label {
  font-size: 26rpx;
  color: var(--muted);
}

.progress-count {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
}

.progress-track {
  width: 100%;
  height: 12rpx;
  background: var(--bg);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 6rpx;
  transition: width 0.3s ease;
  min-width: 0;
}

/* 脚本卡片 */
.script-card {
  padding: 0;
  overflow: hidden;
}

.script-header {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 28rpx 28rpx 0;
}

.script-badge {
  flex-shrink: 0;
  margin-top: 4rpx;
}

.script-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.script-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.script-desc {
  font-size: 24rpx;
  line-height: 1.5;
}

.script-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.7;
  box-sizing: border-box;
}

.input-placeholder {
  color: var(--muted);
  font-size: 26rpx;
}

.textarea-footer {
  padding: 8rpx 28rpx 20rpx;
  text-align: right;
}
