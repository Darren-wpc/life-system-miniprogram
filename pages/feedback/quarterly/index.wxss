/* pages/feedback/quarterly/index.wxss */

/* 季度头部 */
.quarter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.quarter-left {
  display: flex;
  align-items: center;
}

.quarter-icon {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.quarter-info {
  display: flex;
  flex-direction: column;
}

.quarter-label {
  font-size: 24rpx;
  color: var(--muted);
}

.quarter-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  margin-top: 4rpx;
}

.quarter-status {
  flex-shrink: 0;
}

.status-done {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: var(--success-light);
  color: var(--success);
}

.status-pending {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: var(--accent-light);
  color: var(--accent);
}

/* 复盘查看卡片（只读） */
.review-card {
  padding-bottom: 28rpx;
}

.review-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.review-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.review-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.review-question {
  font-size: 24rpx;
  color: var(--muted);
  display: block;
  margin-bottom: 16rpx;
}

.review-answer {
  padding: 20rpx 24rpx;
  background: var(--bg);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.7;
  word-break: break-all;
}

.review-answer.focus-tag {
  display: inline-block;
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
}

/* 表单卡片（编辑） */
.form-card {
  padding-bottom: 24rpx;
}

.form-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.form-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.form-question {
  font-size: 24rpx;
  color: var(--muted);
  display: block;
  margin-bottom: 16rpx;
}

.form-textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx;
  background: var(--bg);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.7;
  box-sizing: border-box;
}

.textarea-placeholder {
  color: var(--muted);
  font-size: 26rpx;
}

/* 因子选择列表 */
.factor-list {
  margin-top: 16rpx;
}

.factor-item {
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--bg);
  margin-bottom: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.factor-item:last-child {
  margin-bottom: 0;
}

.factor-item.factor-selected {
  background: var(--primary-light);
  border-color: var(--primary);
}

.factor-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  display: block;
  margin-bottom: 6rpx;
}

.factor-desc {
  font-size: 22rpx;
  color: var(--muted);
  display: block;
}

/* 保存区域 */
.save-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 10;
}

.save-btn {
  width: 100%;
  border-radius: 16rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
}

/* P1-2: AI 季度总结卡片 */
.ai-summary-card {
  border-left: 6rpx solid var(--primary);
  margin-top: 16rpx;
}

.ai-summary-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.ai-summary-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.ai-summary-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary);
}

.ai-summary-body {
  padding: 4rpx 0;
}

/* 加载动画 */
.ai-summary-loading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}

.ai-summary-loading .loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  animation: ai-loading-bounce 1.4s ease-in-out infinite both;
}

.ai-summary-loading .loading-dot:nth-child(1) {
  animation-delay: 0s;
}

.ai-summary-loading .loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.ai-summary-loading .loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

.ai-summary-loading-text {
  font-size: 26rpx;
  color: var(--muted);
  margin-left: 8rpx;
}

@keyframes ai-loading-bounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.4;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 总结区块 */
.ai-summary-section {
  margin-bottom: 24rpx;
}

.ai-summary-section:last-child {
  margin-bottom: 0;
}

.ai-section-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
  display: block;
  margin-bottom: 12rpx;
}

.ai-section-text {
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.7;
  display: block;
}

/* 趋势列表 */
.ai-trend-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ai-trend-item {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: var(--bg);
  border-radius: 12rpx;
  gap: 8rpx;
}

.ai-trend-label {
  font-size: 24rpx;
  color: var(--ink);
}

.ai-trend-value {
  font-size: 22rpx;
  font-weight: 600;
}

.ai-trend-up {
  color: var(--success);
}

.ai-trend-down {
  color: var(--danger);
}

.ai-trend-stable {
  color: var(--muted);
}

/* 关键发现列表 */
.ai-finding-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ai-finding-item {
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid var(--muted);
  background: var(--bg);
}

.ai-finding-danger {
  border-left-color: var(--danger);
}

.ai-finding-leverage {
  border-left-color: var(--primary);
}

.ai-finding-warning {
  border-left-color: var(--accent);
}

.ai-finding-info {
  border-left-color: var(--info, #2563eb);
}

.ai-finding-success {
  border-left-color: var(--success);
}

.ai-finding-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  display: block;
  margin-bottom: 6rpx;
}

.ai-finding-text {
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.6;
  display: block;
  word-break: break-all;
}

/* 建议列表 */
.ai-recommend-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ai-recommend-item {
  padding: 16rpx 20rpx;
  background: var(--bg);
  border-radius: 12rpx;
}

.ai-recommend-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  gap: 12rpx;
}

.ai-recommend-priority {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.ai-priority-high {
  background: rgba(225, 29, 72, 0.1);
  color: var(--danger);
}

.ai-priority-medium {
  background: rgba(245, 158, 11, 0.1);
  color: var(--accent);
}

.ai-priority-low {
  background: rgba(100, 116, 139, 0.1);
  color: var(--muted);
}

.ai-recommend-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  flex: 1;
}

.ai-recommend-text {
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.6;
  display: block;
  word-break: break-all;
}

/* 来源标记 */
.ai-summary-source {
  margin-top: 16rpx;
  text-align: right;
}

.ai-source-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: var(--muted);
  background: var(--bg);
}
