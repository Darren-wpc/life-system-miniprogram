<!--pages/feedback/quarterly/index.wxml-->
<view class="page-container">

  <!-- 季度选择器 -->
  <view class="quarter-header card">
    <view class="quarter-left">
      <text class="quarter-icon">📅</text>
      <view class="quarter-info">
        <text class="quarter-label">当前季度</text>
        <text class="quarter-value">{{currentQuarter}}</text>
      </view>
    </view>
    <view class="quarter-status" wx:if="{{hasReview}}">
      <text class="status-done">已完成复盘</text>
    </view>
    <view class="quarter-status" wx:else>
      <text class="status-pending">待复盘</text>
    </view>
  </view>

  <!-- 已完成：只读查看（P1-3: 添加编辑入口） -->
  <block wx:if="{{hasReview && !isEditing}}">
    <view class="section-title">结构检视</view>

    <!-- 编辑按钮 -->
    <view class="edit-btn-area" style="text-align: right; margin-bottom: 16rpx;">
      <button class="btn-outline" style="display: inline-block; padding: 12rpx 32rpx; font-size: 24rpx;" bindtap="onEdit">编辑</button>
    </view>

    <!-- 崩溃点 -->
    <view class="card review-card">
      <view class="review-card-header">
        <text class="review-icon">💥</text>
        <text class="review-title">崩溃点检视</text>
      </view>
      <text class="review-question">哪个维度的崩塌会把一切拖下去？</text>
      <view class="review-answer">{{reviewData.collapseText}}</view>
    </view>

    <!-- 杠杆点 -->
    <view class="card review-card">
      <view class="review-card-header">
        <text class="review-icon">🔑</text>
        <text class="review-title">杠杆点检视</text>
      </view>
      <text class="review-question">改善哪个维度能带动其他维度？</text>
      <view class="review-answer">{{reviewData.leverageText}}</view>
    </view>

    <!-- 失衡点 -->
    <view class="card review-card">
      <view class="review-card-header">
        <text class="review-icon">⚖️</text>
        <text class="review-title">失衡点检视</text>
      </view>
      <text class="review-question">是否有某个维度过强，压制了其他维度？</text>
      <view class="review-answer">{{reviewData.imbalanceText}}</view>
    </view>

    <!-- 可持续性 -->
    <view class="card review-card">
      <view class="review-card-header">
        <text class="review-icon">♻️</text>
        <text class="review-title">可持续性检视</text>
      </view>
      <text class="review-question">当前的生活方式能再坚持一年吗？</text>
      <view class="review-answer">{{reviewData.sustainableText}}</view>
    </view>

    <!-- 框架问题 -->
    <view class="section-title">框架更新</view>

    <view class="card review-card">
      <view class="review-card-header">
        <text class="review-icon">📏</text>
        <text class="review-title">标准更新</text>
      </view>
      <text class="review-question">本季度标准需要更新吗？</text>
      <view class="review-answer">{{reviewData.standardUpdateText}}</view>
    </view>

    <view class="card review-card">
      <view class="review-card-header">
        <text class="review-icon">🎯</text>
        <text class="review-title">下季度焦点</text>
      </view>
      <text class="review-question">下一季度集中精力在哪个因子上？</text>
      <view class="review-answer focus-tag">
        <text wx:for="{{factorOptions}}" wx:key="key" wx:if="{{item.key === reviewData.focusFactor}}">
          {{item.name}}
        </text>
      </view>
    </view>

    <!-- P1-2: AI 季度总结卡片 -->
    <view class="card ai-summary-card" wx:if="{{aiSummary || aiSummaryLoading}}">
      <view class="ai-summary-header">
        <text class="ai-summary-icon">🤖</text>
        <text class="ai-summary-title">AI 季度总结</text>
      </view>

      <!-- 加载中动画 -->
      <view class="ai-summary-body" wx:if="{{aiSummaryLoading}}">
        <view class="ai-summary-loading">
          <view class="loading-dot"></view>
          <view class="loading-dot"></view>
          <view class="loading-dot"></view>
        </view>
        <text class="ai-summary-loading-text">正在生成季度总结...</text>
      </view>

      <!-- 总结内容 -->
      <view class="ai-summary-body" wx:elif="{{aiSummary}}">
        <!-- 总体评估 -->
        <view class="ai-summary-section" wx:if="{{aiSummary.summary}}">
          <text class="ai-section-label">总体评估</text>
          <text class="ai-section-text">{{aiSummary.summary}}</text>
        </view>

        <!-- 趋势分析 -->
        <view class="ai-summary-section" wx:if="{{aiSummary.trends && aiSummary.trends.length > 0}}">
          <text class="ai-section-label">维度趋势</text>
          <view class="ai-trend-list">
            <view class="ai-trend-item" wx:for="{{aiSummary.trends}}" wx:key="dimension">
              <text class="ai-trend-label">{{item.label}}</text>
              <text class="ai-trend-value ai-trend-{{item.direction}}">
                {{item.direction === 'up' ? '↑' : item.direction === 'down' ? '↓' : '→'}}
                {{item.from}}→{{item.to}}
                ({{item.change > 0 ? '+' : ''}}{{item.change}})
              </text>
            </view>
          </view>
        </view>

        <!-- 关键发现 -->
        <view class="ai-summary-section" wx:if="{{aiSummary.keyFindings && aiSummary.keyFindings.length > 0}}">
          <text class="ai-section-label">关键发现</text>
          <view class="ai-finding-list">
            <view class="ai-finding-item ai-finding-{{item.type}}" wx:for="{{aiSummary.keyFindings}}" wx:key="title">
              <text class="ai-finding-title">{{item.title}}</text>
              <text class="ai-finding-text">{{item.text}}</text>
            </view>
          </view>
        </view>

        <!-- 下季度建议 -->
        <view class="ai-summary-section" wx:if="{{aiSummary.recommendations && aiSummary.recommendations.length > 0}}">
          <text class="ai-section-label">下季度建议</text>
          <view class="ai-recommend-list">
            <view class="ai-recommend-item" wx:for="{{aiSummary.recommendations}}" wx:key="title">
              <view class="ai-recommend-header">
                <text class="ai-recommend-priority ai-priority-{{item.priority}}">{{item.priority === 'high' ? '高' : item.priority === 'medium' ? '中' : '低'}}</text>
                <text class="ai-recommend-title">{{item.title}}</text>
              </view>
              <text class="ai-recommend-text">{{item.text}}</text>
            </view>
          </view>
        </view>

        <!-- 来源标记 -->
        <view class="ai-summary-source" wx:if="{{aiSummary.source}}">
          <text class="ai-source-tag">{{aiSummary.source === 'cloud' ? '云端 AI' : aiSummary.source === 'cloud-fallback' ? '云端降级' : '本地引擎'}}</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 未完成：输入表单 -->
  <block wx:else>
    <view class="section-title">结构检视</view>

    <view class="callout callout-info mb-24">
      从四个结构性视角审视本季度，发现系统中的薄弱环节和杠杆机会。
    </view>

    <!-- 崩溃点 -->
    <view class="card form-card">
      <view class="form-header">
        <text class="form-icon">💥</text>
        <text class="form-title">崩溃点检视</text>
      </view>
      <text class="form-question">哪个维度的崩塌会把一切拖下去？</text>
      <textarea
        class="form-textarea"
        placeholder="想想如果这个维度崩溃，其他维度会怎样..."
        placeholder-class="textarea-placeholder"
        value="{{collapseText}}"
        bindinput="onCollapseInput"
        maxlength="1000"
        auto-height
      />
    </view>

    <!-- 杠杆点 -->
    <view class="card form-card">
      <view class="form-header">
        <text class="form-icon">🔑</text>
        <text class="form-title">杠杆点检视</text>
      </view>
      <text class="form-question">改善哪个维度能带动其他维度？</text>
      <textarea
        class="form-textarea"
        placeholder="哪个改善能产生最大的连锁效应..."
        placeholder-class="textarea-placeholder"
        value="{{leverageText}}"
        bindinput="onLeverageInput"
        maxlength="1000"
        auto-height
      />
    </view>

    <!-- 失衡点 -->
    <view class="card form-card">
      <view class="form-header">
        <text class="form-icon">⚖️</text>
        <text class="form-title">失衡点检视</text>
      </view>
      <text class="form-question">是否有某个维度过强，压制了其他维度？</text>
      <textarea
        class="form-textarea"
        placeholder="过度投入某一方面是否挤占了其他维度..."
        placeholder-class="textarea-placeholder"
        value="{{imbalanceText}}"
        bindinput="onImbalanceInput"
        maxlength="1000"
        auto-height
      />
    </view>

    <!-- 可持续性 -->
    <view class="card form-card">
      <view class="form-header">
        <text class="form-icon">♻️</text>
        <text class="form-title">可持续性检视</text>
      </view>
      <text class="form-question">当前的生活方式能再坚持一年吗？</text>
      <textarea
        class="form-textarea"
        placeholder="诚实地评估当前的节奏是否可持续..."
        placeholder-class="textarea-placeholder"
        value="{{sustainableText}}"
        bindinput="onSustainableInput"
        maxlength="1000"
        auto-height
      />
    </view>

    <!-- 框架问题 -->
    <view class="section-title">框架更新</view>

    <!-- 标准更新 -->
    <view class="card form-card">
      <view class="form-header">
        <text class="form-icon">📏</text>
        <text class="form-title">本季度标准需要更新吗？</text>
      </view>
      <textarea
        class="form-textarea"
        placeholder="你用来衡量自己的那把尺子，还合适吗..."
        placeholder-class="textarea-placeholder"
        value="{{standardUpdateText}}"
        bindinput="onStandardUpdateInput"
        maxlength="1000"
        auto-height
      />
    </view>

    <!-- 集中因子选择 -->
    <view class="card form-card">
      <view class="form-header">
        <text class="form-icon">🎯</text>
        <text class="form-title">下一季度集中精力在哪个因子上？</text>
      </view>
      <view class="factor-list">
        <view
          class="factor-item {{focusFactor === item.key ? 'factor-selected' : ''}}"
          wx:for="{{factorOptions}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onFactorSelect"
        >
          <text class="factor-name">{{item.name}}</text>
          <text class="factor-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- 保存按钮 -->
    <view class="save-area">
      <button class="btn-primary save-btn" bindtap="onSave" loading="{{saving}}">
        保存季度复盘
      </button>
    </view>
  </block>

</view>
