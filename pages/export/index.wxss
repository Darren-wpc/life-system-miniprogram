/* pages/export/index.wxss - 数据管理样式 */

/* 存储概览 */
.overview-card {
  padding: 32rpx;
}

.overview-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 28rpx;
}

.overview-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.overview-divider {
  width: 2rpx;
  height: 64rpx;
  background: var(--rule);
}

/* 存储进度条 */
.storage-track {
  width: 100%;
  height: 16rpx;
  background: var(--bg);
  border-radius: 8rpx;
  overflow: hidden;
}

.storage-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 8rpx;
  transition: width 0.3s ease;
  min-width: 0;
}

.storage-meta {
  font-size: 22rpx;
  margin-top: 12rpx;
  text-align: right;
}

/* 数据分类列表 */
.cat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--rule);
}

.cat-item:last-child {
  border-bottom: none;
}

.cat-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-right: 24rpx;
}

.cat-name {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
}

.cat-desc {
  font-size: 22rpx;
  line-height: 1.4;
}

.cat-count {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  flex-shrink: 0;
}

.count-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--muted);
}

.count-active {
  color: var(--primary);
}

.count-unit {
  font-size: 22rpx;
}

/* 导出区 */
.export-desc {
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.export-btn {
  width: 100%;
  font-size: 30rpx;
  box-sizing: border-box;
}

.last-export {
  font-size: 22rpx;
  text-align: center;
  margin-top: 20rpx;
}
