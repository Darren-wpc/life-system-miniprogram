<!--pages/profile/pivot/index.wxml - 转向信号检测-->
<view class="page-container">

  <!-- 季度标识 -->
  <view class="quarter-badge">
    <text class="quarter-text">{{currentQuarter}} 季度检测</text>
  </view>

  <!-- 引导语 -->
  <view class="callout callout-info">
    <text>检查以下6个转向信号。勾选你当前正在经历的，系统会给出建议。</text>
  </view>

  <!-- 勾选计数 -->
  <view class="signal-counter card">
    <view class="counter-info">
      <text class="counter-label">已勾选信号</text>
      <text class="counter-number">{{checkedCount}}<text class="counter-total">/{{signals.length}}</text></text>
    </view>
    <view class="counter-track">
      <view class="counter-fill" style="width: {{checkedCount / signals.length * 100}}%"></view>
    </view>
  </view>

  <!-- 6个信号清单 -->
  <view class="signal-list card" style="padding: 0; overflow: hidden;">
    <view class="signal-item" wx:for="{{signals}}" wx:key="id" data-id="{{item.id}}" bindtap="onSignalToggle">
      <view class="signal-check {{item.checked ? 'signal-checked' : ''}}">
        <text class="check-icon" wx:if="{{item.checked}}">✓</text>
      </view>
      <view class="signal-content">
        <text class="signal-text">{{item.text}}</text>
        <view class="signal-auto-tag" wx:if="{{item.autoDetected}}">
          <text class="auto-badge auto-detected">已自动检测</text>
        </view>
        <view class="signal-auto-tag" wx:elif="{{item.autoDetect}}">
          <text class="auto-badge">可自动检测</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 推荐建议 -->
  <view class="callout callout-{{recommendationLevel}}">
    <text>{{recommendationText}}</text>
  </view>

  <!-- P2-1: AI 转向检测 -->
  <view class="ai-pivot-section">
    <view class="section-title">AI 转向检测</view>
    <text class="section-subtitle">基于历史评分趋势，AI 自动检测转向信号</text>

    <!-- 检测按钮 -->
    <button class="ai-pivot-btn" bindtap="onCheckPivot" disabled="{{aiPivotLoading}}">
      <text wx:if="{{aiPivotLoading}}">检测中...</text>
      <text wx:else>AI 转向检测</text>
    </button>

    <!-- 加载中状态 -->
    <view class="ai-pivot-loading" wx:if="{{aiPivotLoading}}">
      <view class="ai-pivot-spinner"></view>
      <text class="ai-pivot-loading-text">正在分析历史评分趋势...</text>
    </view>

    <!-- 检测结果 -->
    <block wx:if="{{aiPivotCheck && !aiPivotLoading}}">
      <!-- 错误状态 -->
      <view class="ai-pivot-error" wx:if="{{aiPivotCheck.error}}">
        <text class="ai-pivot-error-text">{{aiPivotCheck.message}}</text>
      </view>

      <!-- 正常结果 -->
      <view class="ai-pivot-result card" wx:else>
        <!-- 信号数量摘要 -->
        <view class="ai-pivot-header">
          <text class="ai-pivot-count">检测到 {{aiPivotCheck.signalCount}} 个信号</text>
          <text class="ai-pivot-source text-muted" wx:if="{{aiPivotCheck.source === 'cloud'}}">云端AI</text>
          <text class="ai-pivot-source text-muted" wx:elif="{{aiPivotCheck.source === 'cloud-fallback'}}">云端降级</text>
          <text class="ai-pivot-source text-muted" wx:else>本地引擎</text>
        </view>

        <!-- 无信号 -->
        <view class="ai-pivot-empty" wx:if="{{aiPivotCheck.signalCount === 0}}">
          <text class="ai-pivot-empty-text">暂未检测到明显的转向信号，系统运转相对稳定。</text>
        </view>

        <!-- 信号列表 -->
        <view class="ai-signal-list" wx:if="{{aiPivotCheck.signalCount > 0}}">
          <view class="ai-signal-item ai-signal-{{item.severity}}" wx:for="{{aiPivotCheck.signals}}" wx:key="index">
            <view class="ai-signal-badge ai-signal-badge-{{item.severity}}">
              <text wx:if="{{item.severity === 'danger'}}">高危</text>
              <text wx:elif="{{item.severity === 'warning'}}">警告</text>
              <text wx:else>提示</text>
            </view>
            <view class="ai-signal-body">
              <view class="ai-signal-title">
                <text wx:if="{{item.dimensionLabel}}">{{item.dimensionLabel}}</text>
                <text wx:elif="{{item.type === 'consecutiveDecline'}}">连续下行</text>
                <text wx:elif="{{item.type === 'structuralCollapse'}}">结构性崩塌</text>
                <text wx:elif="{{item.type === 'gapWidening'}}">差距扩大</text>
                <text wx:elif="{{item.type === 'historicalSignal'}}">历史信号</text>
                <text wx:else>转向信号</text>
              </view>
              <text class="ai-signal-desc">{{item.description}}</text>
            </view>
          </view>
        </view>

        <!-- AI 建议 -->
        <view class="ai-pivot-recommendation" wx:if="{{aiPivotCheck.recommendation}}">
          <view class="ai-pivot-reco-title">AI 建议</view>
          <text class="ai-pivot-reco-text">{{aiPivotCheck.recommendation}}</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 转向准备清单（信号>=2时显示） -->
  <block wx:if="{{showPrepList}}">
    <view class="prep-section">
      <view class="section-title">转向准备清单</view>
      <text class="section-subtitle">如果真的要转向，逐项确认：</text>

      <view class="prep-list card" style="padding: 0; overflow: hidden;">
        <view class="prep-item" wx:for="{{prepList}}" wx:key="key" data-key="{{item.key}}" bindtap="onPrepToggle">
          <view class="prep-check {{item.checked ? 'prep-checked' : ''}}">
            <text class="prep-check-icon" wx:if="{{item.checked}}">✓</text>
          </view>
          <view class="prep-content">
            <text class="prep-label">{{item.label}}</text>
            <text class="prep-desc text-muted">{{item.text}}</text>
          </view>
        </view>
      </view>

      <!-- 准备清单结论 -->
      <view class="prep-conclusion" wx:if="{{prepConclusion}}">
        <view class="conclusion-card card conclusion-{{prepConclusionType}}">
          <text class="conclusion-icon" wx:if="{{prepConclusionType === 'green'}}">●</text>
          <text class="conclusion-icon" wx:elif="{{prepConclusionType === 'red'}}">●</text>
          <text class="conclusion-icon" wx:else>●</text>
          <text class="conclusion-text">{{prepConclusion}}</text>
        </view>
        <text class="prep-hint text-muted">已确认 {{prepCheckedCount}}/{{prepList.length}} 项</text>
      </view>
    </view>
  </block>

  <!-- 保存按钮 -->
  <view class="save-area">
    <button class="btn-primary save-btn" bindtap="onSave" disabled="{{saving}}">
      {{saving ? '保存中...' : '保存检测结果'}}
    </button>
  </view>

</view>
